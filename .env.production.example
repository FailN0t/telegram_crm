# ============================================================
# Production Configuration Template for AmoCRM Integration
# ============================================================
#
# ВАЖНО: Этот файл - только шаблон!
# 1. Скопируйте на сервер: cp .env.production.example .env
# 2. Заполните реальными значениями
# 3. НИКОГДА не коммитьте .env в git!
#
# ============================================================

# ============================================================
# CRM Provider Selection
# ============================================================
CRM_PROVIDER=amocrm

# ============================================================
# AmoCRM OAuth Configuration
# ============================================================
# Получите из: https://yourdomain.amocrm.ru/settings/dev
AMOCRM_DOMAIN=yourdomain.amocrm.ru
AMOCRM_CLIENT_ID=ваш_integration_id_здесь
AMOCRM_CLIENT_SECRET=ваш_secret_key_здесь
AMOCRM_REDIRECT_URI=https://your-server.example.com/api/admin/amocrm/oauth/callback

# AmoCRM Access Token (получите через OAuth или долгосрочный токен)
AMOCRM_ACCESS_TOKEN=
AMOCRM_REFRESH_TOKEN=
AMOCRM_TOKEN_EXPIRES_AT=

# AmoCRM Custom Field IDs
# Создайте поля в AmoCRM → Настройки → Контакты → Дополнительные поля
AMOCRM_FIELD_TELEGRAM_USERNAME=0
AMOCRM_FIELD_TELEGRAM_CHAT_ID=0
AMOCRM_FIELD_TELEGRAM_CONSENT=0

# AmoCRM Webhook Secret (опционально)
AMOCRM_WEBHOOK_SECRET=сгенерируйте_случайную_строку_32_символа

# ============================================================
# Telegram MTProto Configuration
# ============================================================
# Получите из: https://my.telegram.org/apps
TELEGRAM_API_ID=ваш_api_id
TELEGRAM_API_HASH=ваш_api_hash
TELEGRAM_PHONE=+7XXXXXXXXXX
TELEGRAM_SESSION_NAME=telegram_crm_session
TELEGRAM_STRING_SESSION=

# ============================================================
# Database Configuration
# ============================================================
DATABASE_URL=postgresql://telegram_user:ваш_пароль@localhost:5432/telegram_crm

# PostgreSQL settings (for docker-compose)
POSTGRES_USER=telegram_user
POSTGRES_PASSWORD=ваш_пароль
POSTGRES_DB=telegram_crm

# ============================================================
# Redis Configuration
# ============================================================
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_PORT=6379

# ============================================================
# API Server Configuration
# ============================================================
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=сгенерируйте_случайную_строку_минимум_32_символа

# Rate limiting
API_RATE_LIMIT_PER_MINUTE=120

# ============================================================
# UI Basic Auth
# ============================================================
UI_BASIC_AUTH_ENABLED=true
UI_BASIC_AUTH_USERS=admin:измените_пароль:admin,operator:измените_пароль:operator

# ============================================================
# Anti-Spam Configuration
# ============================================================
# Глобальные лимиты
GLOBAL_MESSAGE_LIMIT_PER_HOUR=50
GLOBAL_NEW_CHATS_LIMIT_PER_DAY=10
MIN_DELAY_BETWEEN_MESSAGES_SECONDS=3

# Contact Manager защита от бана аккаунта
CONTACT_ADD_LIMIT_INBOUND_HOURLY=50
CONTACT_ADD_LIMIT_INBOUND_DAILY=150
CONTACT_ADD_LIMIT_OUTBOUND_HOURLY=3
CONTACT_ADD_LIMIT_OUTBOUND_DAILY=10

# Circuit Breaker настройки
CONTACT_CIRCUIT_BREAKER_THRESHOLD=3
CONTACT_CIRCUIT_BREAKER_TIMEOUT_SECONDS=300

# ============================================================
# Outbox Worker Configuration
# ============================================================
# true = API server отправляет сообщения inline
# false = отдельный worker процесс (рекомендуется для production)
OUTBOX_PROCESS_INLINE=false
OUTBOX_WORKER_POLL_INTERVAL_SECONDS=2
OUTBOX_MAX_RETRIES=5

# ============================================================
# Logging & Observability
# ============================================================
LOG_LEVEL=INFO
DEBUG=false

# Sentry (опционально)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# Metrics
ENABLE_METRICS=true

# ============================================================
# Data Retention
# ============================================================
# Дни хранения данных (0 = не удалять)
UI_MESSAGE_RETENTION_DAYS=90
UI_EVENT_RETENTION_DAYS=30
MESSAGE_HISTORY_RETENTION_DAYS=365
OUTBOX_SENT_RETENTION_DAYS=30
OUTBOX_FAILED_RETENTION_DAYS=90

# ============================================================
# MinIO / S3 Storage (опционально)
# ============================================================
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=telegram-media
MINIO_SECURE=false
MINIO_PUBLIC_URL=http://localhost:9000

# ============================================================
# Security & Compliance
# ============================================================
DEFAULT_TIMEZONE=Europe/Moscow
REQUIRE_CONSENT=false
ENABLE_QUIET_HOURS=true

# ============================================================
# Advanced Settings
# ============================================================
DB_ALLOW_CREATE_ALL=false
DB_USE_NULL_POOL=false
