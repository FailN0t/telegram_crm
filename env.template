# Telegram MTProto (личный аккаунт)
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef
TELEGRAM_PHONE=+79990000000
TELEGRAM_SESSION_NAME=amocrm_session
# TELEGRAM_STRING_SESSION=  # опционально, если используете StringSession из БД

# Application
DEBUG=false
# Можно использовать *_FILE для секретов (Docker/K8s)
# API_SECRET_KEY_FILE=/run/secrets/api_secret_key

# AmoCRM OAuth
AMOCRM_DOMAIN=yourdomain.amocrm.ru
AMOCRM_CLIENT_ID=your_client_id
AMOCRM_CLIENT_SECRET=your_client_secret
AMOCRM_REDIRECT_URI=https://your-app.example.com/oauth/callback
AMOCRM_ACCESS_TOKEN=your_access_token
AMOCRM_REFRESH_TOKEN=your_refresh_token
AMOCRM_TOKEN_EXPIRES_AT=
AMOCRM_WEBHOOK_SECRET=

# AmoCRM custom fields (ID полей; если нет поля — 0)
AMOCRM_FIELD_TELEGRAM_USERNAME=0
AMOCRM_FIELD_TELEGRAM_CHAT_ID=0
AMOCRM_FIELD_TELEGRAM_CONSENT=0

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/telegram_bot
DB_ALLOW_CREATE_ALL=False

# Docker Compose DB/Redis (для production)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=telegram_bot
POSTGRES_PORT=5432
REDIS_PASSWORD=changeme
REDIS_PORT=6379

# Redis (опционально)
REDIS_URL=redis://localhost:6379/0

# MinIO (media storage)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=telegram-media
MINIO_SECURE=False
MINIO_PUBLIC_URL=http://localhost:9000

# API server
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=CHANGE_ME
API_RATE_LIMIT_PER_MINUTE=120
# API_ALLOWED_IPS=1.2.3.4,5.6.7.8

# UI Basic Auth (опционально)
UI_BASIC_AUTH_ENABLED=false
# UI_BASIC_AUTH_USERS=admin:pass:admin,operator:pass:operator

# Compliance
DEFAULT_TIMEZONE=UTC

# Anti-spam limits
MAX_MESSAGES_PER_HOUR=50
MAX_NEW_CHATS_PER_DAY=20
MIN_DELAY_BETWEEN_MESSAGES=5

# Data retention (days, 0 = disable)
UI_MESSAGE_RETENTION_DAYS=365
UI_EVENT_RETENTION_DAYS=90
AUDIT_LOG_RETENTION_DAYS=365
MESSAGE_INBOX_RETENTION_DAYS=30

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# Monitoring / alerts
ENABLE_METRICS=true
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
ALERT_EMAIL=
ERROR_TRACKING_DSN=
ERROR_TRACKING_ENV=production
ERROR_TRACKING_SAMPLE_RATE=0.1
